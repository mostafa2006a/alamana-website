/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/assets/*
  Cache-Control: public, max-age=2592000

# ملفات CSS و JS عليها رقم إصدار (?v=3) — غيّر الرقم في index.html مع كل تعديل
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# ملاحظة: الصفحة الرئيسية "/" بيخدمها الـWorker (worker/index.js)، والملف ده مش بيتطبق عليها.
# الـLink headers وهيدرز الأمان بتاعتها مكتوبة جوه الـWorker نفسه.

# ملفات اكتشاف وكلاء الذكاء الاصطناعي: متاحة للقراءة من أي موقع (CORS)
/.well-known/*
  Access-Control-Allow-Origin: *

/llms.txt
  Access-Control-Allow-Origin: *

# نسخة Markdown من الصفحة الرئيسية — الصفحة الأصلية في نتائج البحث هي "/"
/index.md
  Access-Control-Allow-Origin: *
  Link: <https://alamana.win/>; rel="canonical"
